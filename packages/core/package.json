{
  "name": "@hold-baby/bucket-db",
  "version": "0.7.0",
  "description": "A TypeScript document database built on cloud object storage (AWS S3 / Alibaba Cloud OSS) or local file system. No database servers needed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bucket-db": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp src/ui/index.html dist/ui/",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p . && tsc -p tests/types",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "keywords": [
    "database",
    "document-db",
    "s3",
    "oss",
    "typescript",
    "cloud-storage"
  ],
  "author": "holdbaby5483",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holdbaby5483/bucket-db.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/holdbaby5483/bucket-db#readme",
  "bugs": {
    "url": "https://github.com/holdbaby5483/bucket-db/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
