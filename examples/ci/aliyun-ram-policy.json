{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:PutObject", "oss:DeleteObject"],
      "Resource": "acs:oss:*:*:my-ci-bucket/ci-data/*"
    },
    {
      "Effect": "Allow",
      "Action": "oss:ListObjects",
      "Resource": "acs:oss:*:*:my-ci-bucket",
      "Condition": { "StringLike": { "oss:Prefix": "ci-data/*" } }
    }
  ]
}
